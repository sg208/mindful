{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/**/*",
    "astro.config.mjs",
    "scripts/**/*",
    ".astro/types.d.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
