---
import BaseLayout from './BaseLayout.astro';
import CategoryChip from '~/components/CategoryChip.astro';
import Disclaimer from '~/components/Disclaimer.astro';
import ArticleNav from '~/components/ArticleNav.astro';
import { formatDate, readingMinutes, type Post } from '~/lib/posts';
import { getCategory } from '~/lib/categories';
import { siteConfig } from '~/config/site';

interface Props {
  post: Post;
  previous?: Post;
  next?: Post;
  body: string;
}

const { post, previous, next, body } = Astro.props;
const category = await getCategory(post.data.category);
const minutes = readingMinutes(body);
const publishedIso = post.data.publishedAt.toISOString();
const updatedIso = (post.data.updatedAt ?? post.data.publishedAt).toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.excerpt,
  image: post.data.image ? [post.data.image] : undefined,
  datePublished: publishedIso,
  dateModified: updatedIso,
  author: { '@type': 'Organization', name: siteConfig.author },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    logo: { '@type': 'ImageObject', url: new URL('/icons/icon-512.png', Astro.site).toString() },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/posts/${post.id}`, Astro.site).toString(),
  },
  articleSection: category?.data.label,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.image}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  jsonLd={jsonLd}
>
  <article>
    <header class="mx-auto max-w-[52rem]">
      <nav aria-label="Breadcrumb" class="meta rise mb-6">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li>
            <a href="/" class="link-quiet">
              Mindful
            </a>
          </li>
          {category && (
            <li class="flex items-center gap-x-2">
              <span aria-hidden="true">/</span>
              <a href={`/categories/${category.data.id}`} class="link-quiet">
                {category.data.label}
              </a>
            </li>
          )}
        </ol>
      </nav>
      <h1 class="rise rise-1 font-display text-[clamp(2.25rem,1.3rem+3.6vw,4.25rem)] leading-[1.04] tracking-[-0.03em] text-balance">
        {post.data.title}
      </h1>
      <p class="rise rise-2 mt-6 max-w-[40ch] text-[clamp(1.25rem,1.1rem+0.5vw,1.5rem)] leading-snug text-[var(--ink-soft)]">
        {post.data.excerpt}
      </p>
      <p class="meta rise rise-3 mt-6 flex flex-wrap items-center gap-x-4 gap-y-1">
        {category && <CategoryChip category={category.data} />}
        <time datetime={publishedIso}>{formatDate(post.data.publishedAt)}</time>
        <span>{minutes} min read</span>
      </p>
    </header>

    {post.data.image && (
      <figure class="rise rise-3 mx-auto mt-12 max-w-[64rem] sm:mt-16">
        <img
          src={post.data.image}
          alt={post.data.imageAlt ?? post.data.title}
          width="1200"
          height="600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[2/1] w-full bg-[var(--surface)] object-cover"
        />
      </figure>
    )}

    <div class="mx-auto mt-12 max-w-[52rem] sm:mt-16">
      <div class="prose prose-essay">
        <slot />
      </div>
    </div>

    <div class="mx-auto mt-20 max-w-[52rem]">
      <Disclaimer variant="card" />
    </div>

    <ArticleNav previous={previous} next={next} />
  </article>
</BaseLayout>
