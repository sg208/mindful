---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  lede?: string;
  /** Breadcrumb trail after "Mindful"; the last item is the current page. */
  crumbs?: Crumb[];
}

const { title, lede, crumbs = [] } = Astro.props;
---

<header class="pb-14 sm:pb-20">
  {crumbs.length > 0 && (
    <nav aria-label="Breadcrumb" class="meta rise mb-6">
      <ol class="flex flex-wrap items-center gap-x-2">
        <li>
          <a href="/" class="link-quiet">
            Mindful
          </a>
        </li>
        {crumbs.map((crumb) => (
          <li class="flex items-center gap-x-2">
            <span aria-hidden="true">/</span>
            {crumb.href ? (
              <a href={crumb.href} class="link-quiet">
                {crumb.label}
              </a>
            ) : (
              <span aria-current="page">{crumb.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}
  <h1 class="rise rise-1 font-display max-w-[18ch] text-[clamp(2.375rem,1.4rem+4vw,5rem)] leading-[1.02] tracking-[-0.03em] text-balance">
    {title}
  </h1>
  {lede && (
    <p class="rise rise-2 mt-6 max-w-[42ch] text-[clamp(1.25rem,1.1rem+0.5vw,1.5rem)] leading-snug text-[var(--ink-soft)]">
      {lede}
    </p>
  )}
  <slot />
</header>
