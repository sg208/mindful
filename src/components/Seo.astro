---
import { siteConfig } from '~/config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  image,
  type = 'website',
  publishedAt,
  updatedAt,
  canonical,
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title
  ? `${title} — ${siteConfig.name}`
  : `${siteConfig.name} — ${siteConfig.tagline}`;
const url = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).toString() : undefined;

const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

/** Escape JSON for safe embedding inside an HTML <script> tag. `JSON.stringify`
 * does not escape `</script>`, `<!--`, U+2028, or U+2029 — all of which can
 * break out of a JSON-LD block if they ever appear in post metadata. */
function serializeJsonLd(block: Record<string, unknown>): string {
  return JSON.stringify(block)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
}
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url.toString()} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={title ?? siteConfig.name} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={url.toString()} />
<meta property="og:locale" content={siteConfig.locale} />
{ogImage && <meta property="og:image" content={ogImage} />}
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title ?? siteConfig.name} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{jsonLdBlocks.map((block) => (
  <script is:inline type="application/ld+json" set:html={serializeJsonLd(block)} />
))}
