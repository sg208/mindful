---
import NavLinks from './NavLinks.astro';
import MenuScript from './MenuScript.astro';
import { siteConfig } from '~/config/site';

const currentPath = Astro.url.pathname;
const barLinks = siteConfig.headerNav;
const iconButton =
  'inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[var(--surface)] text-[var(--ink)] transition-transform hover:bg-[color-mix(in_oklch,var(--surface)_80%,var(--ink))] active:scale-95';
---

<header class="sticky top-0 z-40 bg-[var(--bg)]">
  <div class="frame flex items-center justify-between gap-4 py-3 sm:py-4">
    <a href="/" class="link-quiet font-display text-2xl" aria-label={`${siteConfig.name}, home`}>
      {siteConfig.name}
    </a>

    <div class="flex items-center gap-1 sm:gap-6">
      <nav aria-label="Primary" class="hidden md:block">
        <ul class="flex items-center gap-6 text-base">
          {barLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="link-quiet"
                aria-current={currentPath === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={siteConfig.supportHref} class="link-accent px-3 py-2 text-base whitespace-nowrap">
        <span class="sm:hidden">Crisis help</span>
        <span class="hidden sm:inline">Need help now?</span>
      </a>
      <button
        type="button"
        data-menu-open
        aria-label="Open menu"
        aria-controls="site-menu"
        aria-expanded="false"
        class={iconButton}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          class="h-5 w-5"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<dialog
  id="site-menu"
  aria-labelledby="site-menu-title"
  aria-modal="true"
  class="m-0 h-[100dvh] max-h-none w-screen max-w-none bg-[var(--bg)] text-[var(--ink)] backdrop:bg-[color-mix(in_oklch,var(--ink)_50%,transparent)] open:flex open:flex-col"
>
  <div class="frame flex items-center justify-between gap-4 py-3 sm:py-4">
    <p id="site-menu-title" class="font-display text-2xl">
      {siteConfig.name}
    </p>
    <button type="button" data-menu-close aria-label="Close menu" class={iconButton}>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        class="h-5 w-5"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto">
    <div class="frame py-10 sm:py-16">
      <p class="max-w-md text-xl text-[var(--ink-soft)]">{siteConfig.tagline}</p>
      <div class="mt-10 sm:mt-14">
        <NavLinks label="Site menu" variant="menu" />
      </div>
    </div>
  </div>
</dialog>

<MenuScript />
