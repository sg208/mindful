---
import type { Post } from '~/lib/posts';
import { formatDate, readingMinutes } from '~/lib/posts';
import { getCategory } from '~/lib/categories';
import CategoryChip from './CategoryChip.astro';

interface Props {
  post: Post;
  variant?: 'default' | 'row' | 'feature';
  /** Heading level for the card title; keep the page outline valid. */
  headingLevel?: 2 | 3;
  /** Hide the theme link on pages that already belong to one theme. */
  hasTheme?: boolean;
}

const { post, variant = 'default', headingLevel = 3, hasTheme = true } = Astro.props;
const category = hasTheme ? await getCategory(post.data.category) : undefined;
const href = `/posts/${post.id}`;
const isFeature = variant === 'feature';
const minutes = readingMinutes(post.body);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article
  class:list={[
    'grid gap-x-10 gap-y-4',
    isFeature &&
      'md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-end lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)]',
    variant === 'row' && 'md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]',
  ]}
>
  <Heading
    class:list={[
      'font-display text-balance',
      isFeature
        ? 'text-[clamp(2rem,1.2rem+3vw,3.75rem)] leading-[1.02]'
        : 'text-[clamp(1.5rem,1.2rem+1vw,2rem)] leading-[1.12]',
    ]}
  >
    <a href={href} class="link-quiet">
      {post.data.title}
    </a>
  </Heading>

  <div class:list={['flex flex-col gap-3', isFeature && 'md:pb-2']}>
    <p class="max-w-prose text-[var(--ink-soft)]">{post.data.excerpt}</p>
    <p class="meta flex flex-wrap items-center gap-x-3 gap-y-1">
      {category && <CategoryChip category={category.data} />}
      <time datetime={post.data.publishedAt.toISOString()}>
        {formatDate(post.data.publishedAt)}
      </time>
      <span>{minutes} min read</span>
    </p>
    {isFeature && (
      <p class="mt-3">
        <a href={href} class="button" aria-label={`Read the essay: ${post.data.title}`}>
          Read the essay
        </a>
      </p>
    )}
  </div>
</article>
