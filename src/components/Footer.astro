---
import { siteConfig } from '~/config/site';
import NavLinks from './NavLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-close overflow-hidden bg-[var(--close)] text-[var(--close-ink)]">
  <div class="frame pt-20 sm:pt-28">
    <div class="grid gap-14 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10">
      <section aria-labelledby="footer-care-heading" class="max-w-md">
        <h2 id="footer-care-heading" class="font-display text-3xl leading-tight sm:text-4xl">
          Written with care, not as care.
        </h2>
        <p class="mt-5 text-lg text-[var(--close-ink)]">
          {siteConfig.name} is not a substitute for professional mental-health support. If you are
          in crisis, please contact local emergency services or a trusted helpline.
        </p>
        <p class="mt-6">
          <a href={siteConfig.supportHref} class="text-lg text-[var(--close-accent)]">
            Where to find help now
          </a>
        </p>
      </section>

      <NavLinks label="Footer" variant="footer" />
    </div>

    <p class="mt-20 flex flex-wrap justify-between gap-x-6 gap-y-1 text-[0.9375rem] text-[var(--close-muted)]">
      <span>
        &copy; {year} {siteConfig.name}
      </span>
      <span>{siteConfig.tagline}</span>
      <a href={siteConfig.repoUrl} class="text-[var(--close-ink)]">
        Source code on GitHub
      </a>
    </p>
  </div>

  <p aria-hidden="true" class="site-close__name font-display">
    {siteConfig.name}
  </p>
</footer>

<style>
  .site-close {
    --accent: var(--close-accent);
  }

  .site-close__name {
    margin: 0.5rem 0 0;
    padding-inline: clamp(0.75rem, 3vw, 2rem);
    font-size: clamp(6rem, 27vw, 26rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--close-ink) 12%, var(--close));
    transform: translateY(18%);
    user-select: none;
  }
</style>
