---
import { siteConfig } from '~/config/site';
import NavLinks from './NavLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-close overflow-hidden bg-[var(--close)] text-[var(--close-ink)]">
  <div class="frame pt-20 sm:pt-28">
    <div class="grid gap-14 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10">
      <section aria-labelledby="footer-care-heading" class="max-w-md">
        <h2 id="footer-care-heading" class="font-display text-3xl leading-tight sm:text-4xl">
          Written with care, not as care.
        </h2>
        <p class="mt-5 text-lg text-[var(--close-ink)]">
          {siteConfig.name} is not a substitute for professional mental-health support. If you are
          in crisis, please contact local emergency services or a trusted helpline.
        </p>
        <p class="mt-6">
          <a href={siteConfig.supportHref} class="text-lg text-[var(--close-accent)]">
            Where to find help now
          </a>
        </p>
      </section>

      <NavLinks label="Footer" variant="footer" />
    </div>

    <p class="mt-20 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-[0.9375rem] text-[var(--close-muted)]">
      <span>
        &copy; {year} {siteConfig.name}
      </span>
      <span>{siteConfig.tagline}</span>
      <a
        href={siteConfig.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Source code on GitHub (opens in a new tab)"
        class="inline-flex size-6 items-center justify-center text-[var(--close-muted)] transition-colors hover:text-[var(--close-ink)] focus-visible:text-[var(--close-ink)]"
      >
        <svg
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 16 16"
          width="18"
          height="18"
          fill="currentColor"
        >
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
      </a>
    </p>
  </div>

  <p aria-hidden="true" class="site-close__name font-display">
    {siteConfig.name}
  </p>
</footer>

<style>
  .site-close {
    --accent: var(--close-accent);
  }

  .site-close__name {
    margin: 0.5rem 0 0;
    padding-inline: clamp(0.75rem, 3vw, 2rem);
    font-size: clamp(6rem, 27vw, 26rem);
    line-height: 0.8;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--close-ink) 12%, var(--close));
    transform: translateY(18%);
    user-select: none;
  }
</style>
