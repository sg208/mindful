---
import type { Category } from '~/lib/categories';

interface Props {
  category: Pick<Category['data'], 'id' | 'label' | 'accent'>;
  asLink?: boolean;
}

const { category, asLink = true } = Astro.props;
const href = `/categories/${category.id}`;
const Tag = asLink ? 'a' : 'span';
---

<Tag
  class:list={['inline-flex min-h-6 items-center gap-2 text-[var(--ink)]', asLink && 'link-quiet']}
  href={asLink ? href : undefined}
>
  <span
    aria-hidden="true"
    class="inline-block h-2.5 w-2.5 shrink-0"
    style={`background: ${category.accent};`}
  ></span>
  {category.label}
</Tag>
