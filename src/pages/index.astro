---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import CategoryCard from '~/components/CategoryCard.astro';
import Disclaimer from '~/components/Disclaimer.astro';
import type { Post } from '~/lib/posts';
import { getPublishedPosts, getFeaturedPost } from '~/lib/posts';
import { getCategories } from '~/lib/categories';
import { siteConfig } from '~/config/site';
import { homeConfig } from '~/config/home';

const posts = await getPublishedPosts();
const featured = await getFeaturedPost();
const categories = await getCategories();

const picks = homeConfig.editorPickSlugs
  .map((slug) => posts.find((post) => post.id === slug))
  .filter((post): post is Post => post !== undefined && post.id !== featured?.id);

const categoryCounts = categories.map((category) => ({
  category,
  count: posts.filter((post) => post.data.category === category.data.id).length,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: Astro.site?.toString(),
  description: siteConfig.description,
  inLanguage: siteConfig.locale,
};
---

<BaseLayout jsonLd={jsonLd}>
  <section
    class="grid gap-10 pb-16 sm:gap-12 sm:pb-20 md:grid-cols-[1fr_minmax(0,320px)] md:items-end md:gap-16"
  >
    <div class="rise">
      <p class="text-xs tracking-[0.25em] text-[var(--muted)] uppercase">A quiet place to read</p>
      <h1
        class="mt-4 text-5xl leading-[1.02] tracking-tight text-balance sm:text-6xl md:text-7xl"
        style="font-family: var(--font-display); font-weight: 500; font-variation-settings: 'opsz' 144, 'SOFT' 20;"
      >
        Small <em
          style="font-variation-settings: 'opsz' 144, 'SOFT' 100; font-style: italic; color: var(--accent-ink);"
          >reflections</em
        >
        on the everyday practice of being well.
      </h1>
    </div>
    <div
      class="rise rise-1 max-w-sm border-l border-[var(--rule)] pl-5 text-[var(--muted)] sm:pl-8 md:border-r md:border-r-0 md:border-l-0 md:pr-8 md:pl-0 md:text-right"
    >
      <p class="text-base leading-relaxed">{siteConfig.description}</p>
      <p class="mt-4 text-xs tracking-widest uppercase">
        {posts.length} essays &middot; 2&ndash;5 min each
      </p>
    </div>
  </section>

  {
    featured && (
      <section aria-label="Featured essay" class="rise rise-2 mb-20">
        <PostCard post={featured} variant="feature" headingLevel={2} />
      </section>
    )
  }

  {
    picks.length > 0 && (
      <section aria-labelledby="start-heading" class="rise rise-3 mb-20">
        <div class="mb-8 flex items-baseline justify-between gap-4 border-b border-[var(--rule)] pb-4">
          <h2
            id="start-heading"
            class="text-2xl tracking-tight sm:text-3xl"
            style="font-family: var(--font-display); font-weight: 500; font-variation-settings: 'opsz' 36;"
          >
            Start here
          </h2>
          <p class="text-xs tracking-widest text-[var(--muted)] uppercase">Editor picks</p>
        </div>
        <ul class="grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {picks.map((post) => (
            <li>
              <PostCard post={post} headingLevel={3} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    categoryCounts.length > 0 && (
      <section aria-labelledby="themes-heading" class="rise rise-4">
        <div class="mb-8 flex items-baseline justify-between gap-4 border-b border-[var(--rule)] pb-4">
          <h2
            id="themes-heading"
            class="text-2xl tracking-tight sm:text-3xl"
            style="font-family: var(--font-display); font-weight: 500; font-variation-settings: 'opsz' 36;"
          >
            Browse by theme
          </h2>
          <a
            href="/posts"
            class="text-xs tracking-widest text-[var(--muted)] uppercase hover:text-[var(--accent-ink)]"
          >
            All essays &rarr;
          </a>
        </div>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {categoryCounts.map(({ category, count }) => (
            <li class="h-full">
              <CategoryCard category={category.data} count={count} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-24">
    <Disclaimer variant="card" />
  </section>
</BaseLayout>
