---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/PostCard.astro';
import CategoryCard from '~/components/CategoryCard.astro';
import Disclaimer from '~/components/Disclaimer.astro';
import type { Post } from '~/lib/posts';
import { getPublishedPosts, getFeaturedPost, readingMinutes, readingSpanLabel } from '~/lib/posts';
import { getCategories } from '~/lib/categories';
import { siteConfig } from '~/config/site';
import { homeConfig } from '~/config/home';

const posts = await getPublishedPosts();
const featured = await getFeaturedPost();
const categories = await getCategories();

const picks = homeConfig.editorPickSlugs
  .map((slug) => posts.find((post) => post.id === slug))
  .filter((post): post is Post => post !== undefined && post.id !== featured?.id);

const categoryCounts = categories.map((category) => ({
  category,
  count: posts.filter((post) => post.data.category === category.data.id).length,
}));

const readingSpan = readingSpanLabel(posts.map((post) => readingMinutes(post.body)));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: Astro.site?.toString(),
  description: siteConfig.description,
  inLanguage: siteConfig.locale,
};
---

<BaseLayout jsonLd={jsonLd}>
  <section aria-labelledby="home-title" class="pb-20 sm:pb-28">
    <h1
      id="home-title"
      class="rise font-display max-w-[14ch] text-[clamp(2.375rem,1rem+6.4vw,7rem)] leading-[0.98] tracking-[-0.035em]"
    >
      Small reflections on being well.
    </h1>
    <div class="mt-8 grid gap-6 sm:mt-10 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:gap-10">
      <p class="rise rise-1 max-w-[38ch] text-[clamp(1.25rem,1.1rem+0.5vw,1.5rem)] leading-snug">
        {siteConfig.description}
      </p>
      {readingSpan && (
        <p class="rise rise-2 meta md:self-end">
          {posts.length} short essays, each {readingSpan}.{' '}
          <a href="/posts" class="text-[var(--ink)]">
            See them all
          </a>
        </p>
      )}
    </div>
  </section>

  {featured && (
    <section
      aria-label="Featured essay"
      class="rise rise-3 bg-[var(--surface)] px-6 py-10 sm:px-10 sm:py-14"
    >
      <PostCard post={featured} variant="feature" headingLevel={2} />
    </section>
  )}

  {picks.length > 0 && (
    <section
      aria-labelledby="start-heading"
      class="grid gap-8 pt-24 sm:pt-32 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] md:gap-10"
    >
      <div class="reveal">
        <h2
          id="start-heading"
          class="font-display text-[clamp(2.25rem,1.6rem+2.4vw,3.5rem)] leading-none"
        >
          Start here
        </h2>
        <p class="mt-4 max-w-[28ch] text-[var(--ink-soft)]">
          A few essays the editors would hand to a friend on a hard week.
        </p>
      </div>
      <ul class="flex flex-col gap-12">
        {picks.map((post) => (
          <li class="reveal">
            <PostCard post={post} headingLevel={3} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {categoryCounts.length > 0 && (
    <section id="themes" aria-labelledby="themes-heading" class="pt-24 sm:pt-32">
      <div class="reveal flex flex-wrap items-baseline justify-between gap-4">
        <h2
          id="themes-heading"
          class="font-display text-[clamp(2.25rem,1.6rem+2.4vw,3.5rem)] leading-none"
        >
          Browse by theme
        </h2>
        <a href="/posts" class="text-lg">
          All essays
        </a>
      </div>
      <ul class="mt-8">
        {categoryCounts.map(({ category, count }) => (
          <li class="reveal">
            <CategoryCard category={category.data} count={count} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="reveal pt-24 sm:pt-32">
    <Disclaimer variant="card" />
  </div>
</BaseLayout>
