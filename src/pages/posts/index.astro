---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
import { getCategories } from '~/lib/categories';
import { getPublishedPosts, formatDate, readingMinutes } from '~/lib/posts';
import { siteConfig } from '~/config/site';

const categories = await getCategories();
const publishedPosts = await getPublishedPosts();
const groups = categories.map((category) => ({
  category,
  posts: publishedPosts.filter((post) => post.data.category === category.data.id),
}));
const totalCount = groups.reduce((sum, group) => sum + group.posts.length, 0);

const title = 'All essays';
const description = `Every essay on ${siteConfig.name}, grouped by theme. ${totalCount} short reads on anxiety, mindfulness, relationships, self-care, and rest.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${title} — ${siteConfig.name}`,
  description,
  url: new URL('/posts', Astro.site).toString(),
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <PageHeader
    title={title}
    lede={`${totalCount} short reads, grouped by theme. Pick the one that matches the day you are having.`}
    crumbs={[{ label: 'All essays' }]}
  />

  <div class="flex flex-col gap-20 sm:gap-28">
    {groups.map(({ category, posts }) => (
      <section
        aria-labelledby={`group-${category.data.id}`}
        class="grid gap-6 md:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] md:gap-10"
      >
        <div class="reveal md:sticky md:top-24 md:self-start">
          <h2
            id={`group-${category.data.id}`}
            class="font-display flex items-center gap-3 text-[clamp(1.75rem,1.3rem+1.6vw,2.75rem)] leading-tight"
          >
            <span
              aria-hidden="true"
              class="inline-block h-3 w-3 shrink-0"
              style={`background: ${category.data.accent};`}
            ></span>
            <a href={`/categories/${category.data.id}`} class="link-quiet">
              {category.data.label}
            </a>
          </h2>
          <p class="mt-3 max-w-[32ch] text-[var(--ink-soft)]">{category.data.description}</p>
        </div>
        {posts.length === 0 ? (
          <p class="text-[var(--ink-soft)]">No essays in this theme yet.</p>
        ) : (
          <ul class="flex flex-col">
            {posts.map((post) => (
              <li class="reveal">
                <a
                  href={`/posts/${post.id}`}
                  class="index-row flex flex-col gap-1 py-3 no-underline sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
                >
                  <span class="index-row__title text-[1.3125rem] leading-snug">
                    {post.data.title}
                  </span>
                  <span class="meta flex shrink-0 gap-3">
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {formatDate(post.data.publishedAt)}
                    </time>
                    <span>{readingMinutes(post.body)} min</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .index-row__title {
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 180ms ease;
  }

  .index-row:hover .index-row__title,
  .index-row:focus-visible .index-row__title {
    text-decoration-color: currentColor;
  }
</style>
