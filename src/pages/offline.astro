---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
---

<BaseLayout title="Offline" noindex>
  <section class="mx-auto max-w-[52rem] pb-10">
    <PageHeader
      title="You’re offline."
      lede="No signal needed for a breath. When you’re back online, the essays will be here waiting."
    >
      <p class="rise rise-3 mt-10">
        <a href="/" class="button">
          Try again
        </a>
      </p>
    </PageHeader>
  </section>
</BaseLayout>
