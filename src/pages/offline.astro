---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title="Offline" noindex>
  <section class="mx-auto max-w-xl py-16 text-center">
    <p class="text-xs tracking-[0.3em] text-[var(--muted)] uppercase">Offline</p>
    <h1
      class="mt-6 text-5xl leading-tight tracking-tight text-balance sm:text-6xl"
      style="font-family: var(--font-display); font-weight: 500; font-variation-settings: 'opsz' 96;"
    >
      You&rsquo;re offline.
    </h1>
    <p class="mt-6 text-[var(--muted)]">
      No signal needed for a breath. When you&rsquo;re back online, the essays will be here waiting.
    </p>
  </section>
</BaseLayout>
