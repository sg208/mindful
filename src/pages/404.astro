---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHeader from '~/components/PageHeader.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="mx-auto max-w-[52rem] pb-10">
    <PageHeader
      title="This page wandered off."
      lede="The page you were looking for isn’t here. Maybe a breath, and then a quiet return home."
    >
      <p class="rise rise-3 mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="/" class="button">
          Back to Mindful
        </a>
        <a href="/posts" class="text-lg">
          Browse all essays
        </a>
      </p>
    </PageHeader>
  </section>
</BaseLayout>
